# Landscape Planning Agent — environment template
# Copy to .env.local and fill in secrets.

# App
LOG_LEVEL=INFO

# DeepSeek (V3 via OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL (reuse existing stack on host 5433)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=eduagent_user
DB_PASSWORD=123456
DB_NAME=eduagent

# Milvus (docker-compose maps host 19531 → container 19530)
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_COLLECTION=landscape_kb
MILVUS_DENSE_DIM=1024

# Local models (relative to project root; absolute paths also OK)
BGE_M3_MODEL=models/embedding/bge-m3
BGE_RERANKER_MODEL=models/reranker/bge-reranker-large
MINILM_MODEL=models/classifier/all-MiniLM-L6-v2
MODEL_DEVICE=cpu

# RAG
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=8
RAG_RERANK_TOP_N=5
RAG_ENABLE_RERANK=false
INTENT_RETRIEVE_THRESHOLD=0.45

# Uploads
UPLOAD_DIR=uploads

# JWT (local demo; change in any shared environment)
JWT_SECRET=landscape-dev-change-me
JWT_EXPIRE_MINUTES=720
